#include "PPICLF_USER.h"
#include "PPICLF_STD.h"

!############################# USERVP #################################

      subroutine uservp (ix,iy,iz,ieg)

      include 'SIZE'
      include 'NEKUSE'          ! UDIFF, UTRANS

      UDIFF  = 0.0
      UTRANS = 0.0

      return
      end

!############################# USERF ##################################

      subroutine userf  (ix,iy,iz,ieg)

      include 'SIZE'
      include 'NEKUSE'          ! FF[XYZ]
      include 'TOTAL'

      real dpdx
      real h_c, zh_l, zh_t, c_d, xlim_c
      real g_a, g_b, g_c
      real uMag, af
      integer ix,iy,iz,ieg

      ffx = 0.0
      ffy = 0.0
      ffz = 0.0

!      dpdx = 0.4

      h_c  = 22.0   ! canopy height, h
      zh_l = 0.06   ! canopy lower limit, z/h
      zh_t = 1.0    ! canopy upper limit, z/h

      c_d  = 0.26   ! drag coefficient, c_d

      g_a  = 0.4106 ! gauss, a
      g_b  = 0.8408 ! gauss, b
      g_c  = 0.1499 ! gauss, c

      xlim_c = 300.0 ! canopy x-dir limit

      uMag = sqrt(ux**2+uy**2+uz**2)

!----------------------- CANOPY FORCING -------------------------------

      if(((z/h_c .lt. zh_t) .and. (z/h_c .gt. zh_l)) .and.
     + (x .lt. xlim_c)) then

        af = g_a*exp(-((z/h_c - g_b)/g_c)**2)

        ffx=-c_d*af*ux*uMag
        ffy=-c_d*af*uy*uMag
        ffz=-c_d*af*uz*uMag

      endif

!----------------------------------------------------------------------

!      ffx = ffx + dpdx (for constant pressure grad.)

      return
      end

!############################# USERQ ##################################

      subroutine userq  (ix,iy,iz,ieg)

      include 'SIZE'
      include 'NEKUSE'          ! QVOL

      QVOL   = 0.0

      return
      end

!############################ USERCHK #################################

      subroutine userchk

c      implicit none
      include 'SIZE'            !
      include 'TOTAL'

      real rphip(PPICLF_LEX,PPICLF_LEY,PPICLF_LEZ,lelt)
      real*8 y(PPICLF_LRS    , PPICLF_LPART) ! Normal ordering
      real*8 rprop(PPICLF_LRP, PPICLF_LPART) ! Normal ordering
      real dx,dy,dz,ubar
      real dvxdx(lx1, ly1, lz1, lelv),
     &     dvxdy(lx1, ly1, lz1, lelv),
     &     dvxdz(lx1, ly1, lz1, lelv),
     &     dvydx(lx1, ly1, lz1, lelv),
     &     dvydy(lx1, ly1, lz1, lelv),
     &     dvydz(lx1, ly1, lz1, lelv),
     &     dvzdx(lx1, ly1, lz1, lelv),
     &     dvzdy(lx1, ly1, lz1, lelv),
     &     dvzdz(lx1, ly1, lz1, lelv)
      integer*4 part_on,part_io,npart,in_freq,in_end

!----------------------- KTH FRAMEWORK --------------------------------

!     start framework
      if (ISTEP.eq.0) call frame_start

!     monitor simulation
      call frame_monitor

!     save/load files for full-restart
      call chkpt_main

!     for statistics
      call stat_avg

!     finalise framework
      if (ISTEP.eq.NSTEPS.or.LASTEP.eq.1) then
         call frame_end
      endif

!------------------------ RECYCLING BC --------------------------------

      dx = uparam(1)
      dy = 0.
      dz = 0.
      ubar = uparam(2)
      call set_inflow_fpt(dx,dy,dz,ubar)

!------------------------ PARTICLE SOLUTION ---------------------------

!     Solve for particles?
      part_on = uparam(3)
      part_io = uparam(4)

!     Inject particles this many steps
      in_freq = 400

!     But wait for this many steps to start/end
      in_end = 3201

!     Check and see if particles need to be added
      if ( ( mod(istep,in_freq) .eq. 0) .and. 
     >     ( istep .le. in_end ) .and.
     >     ( part_on .eq. 1)) then

!        Place and add particles
         call inject_particle(npart,y,rprop)
         call ppiclf_solve_AddParticles(npart,y,rprop)

      endif

!     Check and see if particles are being solved
      if ( part_on .eq. 1) then

!       Calculate and smoothen velocity gradients         
        call gradm1(dvxdx, dvxdy, dvxdz, vx)


        n = nx1*ny1*nz1*nelv


        call col2(dvxdz, bm1, n)
        call dssum(dvxdz, nx1, ny1, nz1)
        call col2(dvxdz, binvm1, n)


!     Interpolate fields and integrate particles
        call ppiclf_solve_InterpFieldUser(PPICLF_R_JUX
     >                          ,vx(1,1,1,1))
        call ppiclf_solve_InterpFieldUser(PPICLF_R_JUY
     >                          ,vy(1,1,1,1))
        call ppiclf_solve_InterpFieldUser(PPICLF_R_JUZ
     >                          ,vz(1,1,1,1))
        call ppiclf_solve_InterpFieldUser(PPICLF_R_JVXZ
     >                          ,dvxdz(1,1,1,1))


        call ppiclf_solve_IntegrateParticle(istep,
     >                                    part_io,
     >                                    dt     ,
     >                                    time   )

      endif

!-----------------------------------------------------------------------

      return
      end

!############################ USERBC ###################################

      subroutine userbc(ix,iy,iz,iside,ieg) 

c      implicit none

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'

      integer ix,iy,iz,iside,ieg,e
      common /cvelbc/ uin(lx1,ly1,lz1,lelv)
     $              , vin(lx1,ly1,lz1,lelv)
     $              , win(lx1,ly1,lz1,lelv)


      e = gllel(ieg)

      ux = uin(ix,iy,iz,e)
      uy = vin(ix,iy,iz,e)
      uz = win(ix,iy,iz,e)

!------------------------- DONG OUTFLOW -------------------------------

      pa = 0.0
      if (cbu.eq.'o  ') then
         U0 = uparam(2)           ! characteristic velocity
         delta = 0.1              ! small positive constant
         pa = dongOutflow(ix,iy,iz,e,iside,U0,delta)
      endif

!----------------------------------------------------------------------

      temp = 0.0

      return
      end

!############################ USERIC ###################################      

      subroutine useric (ix,iy,iz,ieg)

      include 'SIZE'
      include 'TOTAL'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, Z

      integer ix,iy,iz,ieg

      real kx, ky, u_tau

      XLEN = 550.0
      YLEN = 150.0

      u_tau = uparam(5)

      eps = 2e-2
      kx = 40
      ky = 20

      alpha = kx * 300/XLEN
      beta  = ky * 150/YLEN

!------------------------- INITIAL PROFILE ----------------------------

      if (z .gt. 0.0) then
         ux = u_tau*log(z)/log(44.0)
      endif

!----------------------------------------------------------------------

      uy = 0.0
      uz = 0.0

      ux = ux + eps*beta*sin(alpha*x)*cos(beta*y)
      uy =    -eps*alpha*cos(alpha*x)*sin(beta*y)
      uz =      eps*beta*sin(alpha*x)*cos(beta*y)

      return
      end

!############################ USERDAT #################################

      subroutine usrdat

      include 'SIZE'

      return
      end

!########################### USERDAT2 #################################

      subroutine usrdat2() 

c      implicit none

      include 'SIZE'
      include 'TOTAL'
      include 'ZPER'   ! for nelx,nely,nelz

      common /nekmpi/ mid,mp,nekcomm,nekgroup,nekreal

      real*8 y(PPICLF_LRS    , PPICLF_LPART) ! Normal ordering
      real*8 rprop(PPICLF_LRP, PPICLF_LPART) ! Normal ordering

      integer*4 imethod, iendian, npart, part_on


!------------------------ PARTICLE SOLUTION ---------------------------

      part_on = uparam(3)

      if ( part_on .eq. 1) then

!     Pass to library to Init MPI
         call ppiclf_comm_InitMPI(nekcomm,
     >                            nid    , ! nid already defined in Nek5000
     >                            np     ) ! np already defined in Nek5000

!     Place particles
         npart = 0

         imethod = 1
         iendian = 0


c         call ppiclf_io_ReadParticleVTU("par00717.vtu")
         call ppiclf_solve_InitParticle(imethod   ,
     >                                  ndim      ,
     >                                  iendian   ,
     >                                  npart     ,
     >                                  y(1,1)    ,
     >                                  rprop(1,1))


!        Specify Overlap Mesh
         call ppiclf_comm_InitOverlapMesh(nelt,lx1,ly1,lz1,xm1,ym1,zm1)

!        Specify neighbor bin size
         call ppiclf_solve_InitTargetBins('y',8,1)
         call ppiclf_solve_InitTargetBins('z',3,1)
c         call ppiclf_io_ReadWallVTK("wall.vtk")

!        Add a bottom wall boundary
         call ppiclf_solve_InitWall( 
     >                 (/0.0,0.0,0.0/),
     >                 (/465.0,0.0,0.0/),
     >                 (/465.0,150.0,0.0/))
         call ppiclf_solve_InitWall( 
     >                 (/0.0,0.0,0.0/),
     >                 (/0.0,150.0,0.0/),
     >                 (/465.0,150.0,0.0/))

!        Set left and right boundaries to periodic
         call ppiclf_solve_InitPeriodicX(280.0,465.0)
         call ppiclf_solve_InitPeriodicY(0.0,150.0)


      endif

!------------------------ GMSH BC HANDLING ----------------------------     

      do iel=1,nelv
        do ifc=1,2*ndim
          id_face = bc(5,ifc,iel,1)
           if (id_face.eq.11) then
             cbc(ifc,iel,1) = 'v  '
           elseif (id_face.eq.22) then
             cbc(ifc,iel,1) = 'o  '
           elseif (id_face.eq.90) then
             cbc(ifc,iel,1) = 'W  '
           elseif (id_face.eq.99) then
             cbc(ifc,iel,1) = 'SYM'
           endif
        enddo
      enddo

!----------------------------------------------------------------------

      return
      end

